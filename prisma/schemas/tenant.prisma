model Tenant {
    id                  String   @id @default(uuid())
    companyName         String
    slug                String   @unique 
    isActive            Boolean  @default(true)
    industry            String? 
    size                String? 
    address             String?
    contactEmail        String?
    phone               String?
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt
    allowedIps          String[] 
    stripeSecretKey     String?
    stripeWebhookSecret String?

    users    User[]
    roles    Role[]
    branches Branch[] 

    @@index([slug]) 
    @@index([companyName]) 
}

model Branch {
    id        String   @id @default(uuid())
    name      String
    location  String?
    isMain    Boolean  @default(false)
    tenantId  String
    tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([tenantId]) 
}
