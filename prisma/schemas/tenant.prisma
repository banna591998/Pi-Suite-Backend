model Tenant {
    id                  String   @id @default(uuid())
    companyName         String
    slug                String   @unique // Used for fast URL slug lookups (O(1) via hash index)
    isActive            Boolean  @default(true)
    industry            String? // e.g., Supply Chain, Manufacturing, Retail
    size                String? // e.g., 1-50, 51-200, 500+
    address             String?
    contactEmail        String?
    phone               String?
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt
    allowedIps          String[] // IP Whitelisting for Enterprise Security
    stripeSecretKey     String?
    stripeWebhookSecret String?

    users    User[]
    roles    Role[]
    branches Branch[] // Multi-location/Warehouse support

    @@index([slug]) // O(1) Lookup Table optimization for routing & tenant resolution
    @@index([companyName]) // Fast search indexing
}

model Branch {
    id        String   @id @default(uuid())
    name      String
    location  String?
    isMain    Boolean  @default(false)
    tenantId  String
    tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([tenantId]) // Optimized for multi-tenant isolation queries
}
