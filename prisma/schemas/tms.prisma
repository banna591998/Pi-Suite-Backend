model FleetVehicle {
    id            String        @id @default(uuid())
    tenantId      String
    vehicleNumber String        @unique
    driverName    String
    phoneNumber   String
    capacityKg    Float
    currentLat    Float?
    currentLng    Float?
    status        VehicleStatus @default(IDLE)
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @updatedAt

    shipments Shipment[]

    @@index([tenantId])
    @@index([tenantId, status])
}

model Shipment {
    id              String         @id @default(uuid())
    tenantId        String
    trackingNumber  String         @unique
    vehicleId       String?
    origin          String
    destination     String
    freightCost     Float
    status          ShipmentStatus @default(DISPATCHED)
    eBOLDocumentUrl String?
    podOtp          String?
    deliveredAt     DateTime?
    createdAt       DateTime       @default(now())
    updatedAt       DateTime       @updatedAt

    vehicle FleetVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

    @@index([tenantId])
    @@index([tenantId, trackingNumber])
    @@index([tenantId, status])
}
